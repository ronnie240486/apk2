<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p029zz.XplayViewBG
        android:id="@+id/viewGroupdddd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <ImageView
        android:id="@+id/bg_view"
        android:background="@color/black_50"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ly_home"
        android:background="@color/trans_parent"
        android:visibility="visible"
        android:layout_width="@dimen/_55sdp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/west"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/image_logo_rtx"
                android:layout_width="@dimen/_55sdp"
                android:layout_height="@dimen/_55sdp">
                <p029zz.XplayView
                    android:gravity="center"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:layout_width="@dimen/_51sdp"
                    android:layout_height="@dimen/_51sdp"
                    android:layout_margin="@dimen/_2sdp"
                    android:scaleType="fitXY"/>
            </LinearLayout>
            <View
                android:id="@+id/view1"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ly_live"
                android:background="@drawable/bbtn"
                android:focusable="true"
                android:nextFocusRight="@+id/ly_account"
                android:nextFocusUp="@+id/ly_account"
                android:nextFocusDown="@+id/ly_movie"
                android:clickable="true"
                android:layout_width="@dimen/_55sdp"
                android:layout_height="@dimen/_55sdp">
                <ImageView
                    android:gravity="center"
                    android:id="@+id/image_live"
                    android:visibility="visible"
                    android:layout_width="@dimen/_35sdp"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_margin="@dimen/_10sdp"
                    android:src="@drawable/tv_icon"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/txt_live"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/image_live"
                    app:layout_constraintTop_toTopOf="parent"/>
                <requestFocus/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ly_movie"
                android:background="@drawable/bbtn"
                android:focusable="true"
                android:visibility="visible"
                android:nextFocusRight="@+id/ly_account"
                android:nextFocusUp="@+id/ly_live"
                android:nextFocusDown="@+id/ly_series"
                android:clickable="true"
                android:layout_width="@dimen/_55sdp"
                android:layout_height="@dimen/_55sdp">
                <ImageView
                    android:gravity="center"
                    android:id="@+id/image_movie"
                    android:layout_width="@dimen/_35sdp"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_margin="@dimen/_10sdp"
                    android:src="@drawable/movie_icon"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/txt_movie"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/image_movie"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ly_series"
                android:background="@drawable/bbtn"
                android:focusable="true"
                android:visibility="visible"
                android:nextFocusRight="@+id/ly_account"
                android:nextFocusUp="@+id/ly_movie"
                android:nextFocusDown="@+id/ly_setting"
                android:clickable="true"
                android:layout_width="@dimen/_55sdp"
                android:layout_height="@dimen/_55sdp">
                <ImageView
                    android:gravity="center"
                    android:id="@+id/image_series"
                    android:layout_width="@dimen/_35sdp"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_margin="@dimen/_10sdp"
                    android:src="@drawable/icon_series"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/txt_series"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/image_series"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/view2"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ly_setting"
                android:background="@drawable/bbtn"
                android:focusable="true"
                android:visibility="visible"
                android:nextFocusRight="@+id/ly_account"
                android:nextFocusUp="@+id/ly_series"
                android:nextFocusDown="@+id/ly_setting"
                android:clickable="true"
                android:layout_width="@dimen/_55sdp"
                android:layout_height="@dimen/_55sdp">
                <ImageView
                    android:gravity="center"
                    android:id="@+id/image_setting"
                    android:layout_width="@dimen/_35sdp"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_margin="@dimen/_10sdp"
                    android:src="@drawable/ic_setting"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/txt_setting"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/image_setting"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/west"
        android:background="@color/trans_parent"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ly_home"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:gravity="center"
            android:id="@+id/webview"
            android:layout_width="@dimen/_280sdp"
            android:layout_height="@dimen/_20sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ly_bar"
            android:background="@drawable/xplay_login_btn_selector"
            android:paddingLeft="20dp"
            android:paddingTop="@dimen/_10sdp"
            android:paddingRight="20dp"
            android:paddingBottom="@dimen/_10sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/webview">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ly_account"
                android:background="@drawable/rounded"
                android:paddingRight="10dp"
                android:focusable="true"
                android:visibility="visible"
                android:nextFocusLeft="@+id/ly_live"
                android:nextFocusRight="@+id/ly_reload"
                android:nextFocusDown="@+id/ly_live"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_25sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ly_account">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/image_account"
                    android:background="@drawable/round"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp">
                    <ImageView
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_15sdp"
                        android:src="@drawable/account_icon"
                        android:scaleType="fitCenter"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/txt_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/image_account"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:gravity="center"
                android:background="#50ffffff"
                android:layout_width="1.5dp"
                android:layout_height="20dp"
                android:layout_marginLeft="32dp"
                android:layout_marginRight="32dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ly_reload"
                android:background="@drawable/rounded"
                android:paddingRight="10dp"
                android:focusable="true"
                android:visibility="visible"
                android:nextFocusLeft="@+id/ly_account"
                android:nextFocusRight="@+id/ly_exit"
                android:nextFocusDown="@+id/ly_live"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_25sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ly_account">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/image_reload"
                    android:background="@drawable/round"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp">
                    <ImageView
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_15sdp"
                        android:src="@drawable/reload_icon"
                        android:scaleType="fitCenter"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/txt_reload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/image_reload"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:gravity="center"
                android:background="#50ffffff"
                android:layout_width="1.5dp"
                android:layout_height="20dp"
                android:layout_marginLeft="32dp"
                android:layout_marginRight="32dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ly_change"
                android:background="@drawable/rounded"
                android:paddingRight="10dp"
                android:focusable="true"
                android:visibility="gone"
                android:nextFocusLeft="@+id/ly_reload"
                android:nextFocusRight="@+id/ly_change"
                android:nextFocusDown="@+id/ly_live"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_25sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ly_account">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/image_change"
                    android:background="@drawable/round"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp">
                    <ImageView
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_15sdp"
                        android:src="@drawable/exit_icon"
                        android:scaleType="fitCenter"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/txt_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/image_change"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ly_exit"
                android:background="@drawable/rounded"
                android:paddingRight="10dp"
                android:focusable="true"
                android:visibility="visible"
                android:nextFocusLeft="@+id/ly_reload"
                android:nextFocusRight="@+id/ly_exit"
                android:nextFocusDown="@+id/ly_live"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_25sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ly_account">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/image_exit"
                    android:background="@drawable/round"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp">
                    <ImageView
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_15sdp"
                        android:src="@drawable/exit_icon"
                        android:scaleType="fitCenter"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:id="@+id/txt_exit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/image_exit"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/rtx_ads"
            android:layout_width="@dimen/_450sdp"
            android:layout_height="@dimen/_180sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_20sdp"
            android:foreground="@color/trans_parent"
            app:cardBackgroundColor="@color/trans_parent"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ly_bar">
            <p029zz.XplayAdsView
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:layerType="software"/>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/txt_middle_font"
        android:textStyle="bold"
        android:textColor="@color/gray"
        android:id="@+id/txt_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ly_home"
        app:layout_constraintTop_toBottomOf="@+id/rtx_ads"/>
    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:src="@drawable/loader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/_13sdp"
        android:textColor="@color/white"
        android:id="@+id/txt_version"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
