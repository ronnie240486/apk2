<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p029zz.XplayViewBG
        android:id="@+id/viewGroupdddd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <ImageView
        android:id="@+id/image_bg"
        android:background="@color/black_50"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <p029zz.XplayBDView
        android:id="@+id/rtx_ads"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:selectable="false"/>
    <ImageView
        android:id="@+id/bg_view"
        android:background="@drawable/bg_gradient_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/image_logo"
        android:visibility="gone"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:src="@drawable/home_logo"
        android:layout_marginEnd="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <p029zz.XplayView
        android:id="@+id/image_logo_rtx"
        android:layout_width="@dimen/_60sdp"
        android:layout_height="@dimen/_60sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:src="@drawable/home_logo"
        android:layout_marginEnd="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ly_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_25sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_live"
            android:background="@drawable/home_item_bg"
            android:focusable="true"
            android:nextFocusLeft="@+id/ly_live"
            android:nextFocusRight="@+id/ly_movie"
            android:nextFocusUp="@+id/ly_live"
            android:nextFocusDown="@+id/ly_live"
            android:clickable="true"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/image_live"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@drawable/tv_icon"
                app:layout_constraintBottom_toTopOf="@+id/txt_live"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/txt_small_font"
                android:textColor="@color/white"
                android:id="@+id/txt_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image_live"/>
            <requestFocus/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_movie"
            android:background="@drawable/home_item_bg"
            android:focusable="true"
            android:nextFocusLeft="@+id/ly_live"
            android:nextFocusRight="@+id/ly_series"
            android:nextFocusUp="@+id/ly_movie"
            android:nextFocusDown="@+id/ly_movie"
            android:clickable="true"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintStart_toEndOf="@+id/ly_live"
            app:layout_constraintTop_toTopOf="@+id/ly_live">
            <ImageView
                android:id="@+id/image_movie"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@drawable/movie_icon"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@+id/txt_movie"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/txt_small_font"
                android:textColor="@color/white"
                android:id="@+id/txt_movie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image_movie"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_series"
            android:background="@drawable/home_item_bg"
            android:focusable="true"
            android:nextFocusLeft="@+id/ly_movie"
            android:nextFocusRight="@+id/ly_account"
            android:nextFocusUp="@+id/ly_series"
            android:nextFocusDown="@+id/ly_series"
            android:clickable="true"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintStart_toEndOf="@+id/ly_movie"
            app:layout_constraintTop_toTopOf="@+id/ly_live">
            <ImageView
                android:id="@+id/image_series"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@drawable/icon_series"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@+id/txt_series"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/txt_small_font"
                android:textColor="@color/white"
                android:id="@+id/txt_series"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image_series"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_account"
            android:background="@drawable/home_item_bg"
            android:focusable="true"
            android:nextFocusLeft="@+id/ly_series"
            android:nextFocusRight="@+id/ly_reload"
            android:nextFocusUp="@+id/ly_account"
            android:nextFocusDown="@+id/ly_account"
            android:clickable="true"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintStart_toEndOf="@+id/ly_series"
            app:layout_constraintTop_toTopOf="@+id/ly_live">
            <ImageView
                android:id="@+id/image_account"
                android:padding="@dimen/_2sdp"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@drawable/account_icon"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@+id/txt_account"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/txt_small_font"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/txt_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image_account"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_change"
            android:background="@drawable/home_item_bg"
            android:focusable="true"
            android:visibility="gone"
            android:nextFocusLeft="@+id/ly_account"
            android:nextFocusRight="@+id/ly_reload"
            android:nextFocusUp="@+id/ly_change"
            android:nextFocusDown="@+id/ly_change"
            android:clickable="true"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintStart_toEndOf="@+id/ly_account"
            app:layout_constraintTop_toTopOf="@+id/ly_live">
            <ImageView
                android:id="@+id/image_change"
                android:padding="@dimen/_2sdp"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@drawable/change_m3u_icon"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@+id/txt_change"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/txt_small_font"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/txt_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image_change"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_reload"
            android:background="@drawable/home_item_bg"
            android:focusable="true"
            android:nextFocusLeft="@+id/ly_account"
            android:nextFocusRight="@+id/ly_setting"
            android:nextFocusUp="@+id/ly_reload"
            android:nextFocusDown="@+id/ly_reload"
            android:clickable="true"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintStart_toEndOf="@+id/ly_change"
            app:layout_constraintTop_toTopOf="@+id/ly_live">
            <ImageView
                android:id="@+id/image_reload"
                android:padding="@dimen/_2sdp"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@drawable/reload_icon"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@+id/txt_reload"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/txt_small_font"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/txt_reload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image_reload"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_setting"
            android:background="@drawable/home_item_bg"
            android:focusable="true"
            android:nextFocusLeft="@+id/ly_reload"
            android:nextFocusRight="@+id/ly_exit"
            android:nextFocusUp="@+id/ly_setting"
            android:nextFocusDown="@+id/ly_setting"
            android:clickable="true"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintStart_toEndOf="@+id/ly_reload"
            app:layout_constraintTop_toTopOf="@+id/ly_live">
            <ImageView
                android:id="@+id/image_setting"
                android:padding="@dimen/_2sdp"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@drawable/ic_setting"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@+id/txt_setting"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/txt_small_font"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/txt_setting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image_setting"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_exit"
            android:background="@drawable/home_item_bg"
            android:focusable="true"
            android:nextFocusLeft="@+id/ly_setting"
            android:nextFocusRight="@+id/ly_exit"
            android:nextFocusUp="@+id/ly_exit"
            android:nextFocusDown="@+id/ly_exit"
            android:clickable="true"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintStart_toEndOf="@+id/ly_setting"
            app:layout_constraintTop_toTopOf="@+id/ly_live">
            <ImageView
                android:id="@+id/image_exit"
                android:padding="@dimen/_2sdp"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:src="@drawable/exit_icon"
                android:layout_marginStart="@dimen/_13sdp"
                app:layout_constraintBottom_toTopOf="@+id/txt_exit"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/txt_small_font"
                android:textColor="@color/white"
                android:id="@+id/txt_exit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image_exit"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:src="@drawable/loader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/txt_middle_font"
        android:textStyle="bold"
        android:textColor="@color/gray"
        android:id="@+id/txt_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_5sdp"
        android:text="03:00AM"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/_9sdp"
        android:textColor="@color/white"
        android:id="@+id/txt_version"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
