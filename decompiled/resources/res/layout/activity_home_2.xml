<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p029zz.XplayViewBG
        android:id="@+id/viewGroupdddd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <ImageView
        android:id="@+id/image_bg"
        android:background="@color/black_50"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/image_logo"
        android:visibility="gone"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:src="@drawable/home_logo"
        app:layout_constraintBottom_toTopOf="@+id/ly_home"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <p029zz.XplayView
        android:id="@+id/image_logo_rtx"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/_25sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ly_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:paddingVertical="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_live"
            android:background="@drawable/front_round_live"
            android:focusable="true"
            android:nextFocusLeft="@+id/ly_live"
            android:nextFocusRight="@+id/ly_movie"
            android:nextFocusDown="@+id/ly_series"
            android:clickable="true"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp"
            android:layout_marginLeft="@dimen/_25sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:gravity="center"
                android:id="@+id/image_live"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/round_live"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@+id/txt_live"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/white"
                android:id="@+id/txt_live"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image_live"/>
            <requestFocus/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_movie"
            android:background="@drawable/front_round_movie"
            android:focusable="true"
            android:nextFocusLeft="@+id/ly_live"
            android:nextFocusRight="@+id/ly_reload"
            android:nextFocusUp="@+id/ly_reload"
            android:nextFocusDown="@+id/ly_account"
            android:clickable="true"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintStart_toEndOf="@+id/ly_live"
            app:layout_constraintTop_toTopOf="@+id/ly_live">
            <ImageView
                android:id="@+id/image_movie"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/round_movie"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@+id/txt_movie"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/white"
                android:id="@+id/txt_movie"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image_movie"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_series"
            android:background="@drawable/front_round_series"
            android:focusable="true"
            android:nextFocusLeft="@+id/ly_series"
            android:nextFocusRight="@+id/ly_account"
            android:nextFocusUp="@+id/ly_live"
            android:nextFocusDown="@+id/ly_series"
            android:clickable="true"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp"
            android:layout_marginTop="@dimen/_10sdp"
            app:layout_constraintStart_toStartOf="@+id/ly_live"
            app:layout_constraintTop_toBottomOf="@+id/ly_live">
            <ImageView
                android:id="@+id/image_series"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/round_series"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@+id/txt_series"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/txt_series"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image_series"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_account"
            android:background="@drawable/front_round_sport"
            android:focusable="true"
            android:nextFocusLeft="@+id/ly_series"
            android:nextFocusRight="@+id/ly_reload"
            android:nextFocusUp="@+id/ly_movie"
            android:nextFocusDown="@+id/ly_account"
            android:clickable="true"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp"
            app:layout_constraintBottom_toBottomOf="@+id/ly_series"
            app:layout_constraintStart_toStartOf="@+id/ly_movie">
            <ImageView
                android:id="@+id/image_account"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/round_sport"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@+id/txt_account"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/_10sdp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/txt_account"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image_account"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <p029zz.XplayAdsView
            android:id="@+id/rtx_ads"
            android:background="@color/trans_parent"
            android:layout_width="0dp"
            android:layout_height="@dimen/_165sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_25sdp"
            app:layout_constraintBottom_toBottomOf="@+id/ly_account"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ly_movie"
            app:layout_constraintTop_toTopOf="@+id/ly_movie"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ly_exit"
        android:background="@drawable/home_small_item_bg"
        android:focusable="true"
        android:nextFocusLeft="@+id/ly_setting"
        android:nextFocusRight="@+id/ly_exit"
        android:nextFocusUp="@+id/ly_exit"
        android:nextFocusDown="@+id/ly_movie"
        android:clickable="true"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_25sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/image_exit"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:src="@drawable/exit_icon"
            android:layout_marginStart="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/_11sdp"
            android:textColor="@color/white"
            android:id="@+id/txt_exit"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/image_change"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ly_setting"
        android:background="@drawable/home_small_item_bg"
        android:focusable="true"
        android:nextFocusLeft="@+id/ly_reload"
        android:nextFocusRight="@+id/ly_exit"
        android:nextFocusUp="@+id/ly_setting"
        android:nextFocusDown="@+id/ly_movie"
        android:clickable="true"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        app:layout_constraintBottom_toBottomOf="@+id/ly_exit"
        app:layout_constraintEnd_toStartOf="@+id/ly_exit"
        app:layout_constraintTop_toTopOf="@+id/ly_exit">
        <ImageView
            android:id="@+id/image_setting"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:src="@drawable/ic_setting"
            android:layout_marginStart="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/_11sdp"
            android:textColor="@color/white"
            android:id="@+id/txt_setting"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/image_setting"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ly_reload"
        android:background="@drawable/home_small_item_bg"
        android:focusable="true"
        android:nextFocusLeft="@+id/ly_movie"
        android:nextFocusRight="@+id/ly_setting"
        android:nextFocusUp="@+id/ly_reload"
        android:nextFocusDown="@+id/ly_movie"
        android:clickable="true"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        app:layout_constraintBottom_toBottomOf="@+id/ly_exit"
        app:layout_constraintEnd_toStartOf="@+id/ly_setting"
        app:layout_constraintTop_toTopOf="@+id/ly_exit">
        <ImageView
            android:id="@+id/image_reload"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:src="@drawable/reload_icon"
            android:layout_marginStart="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/_11sdp"
            android:textColor="@color/white"
            android:id="@+id/txt_reload"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ly_reload"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ly_change"
        android:background="@drawable/home_small_item_bg"
        android:focusable="true"
        android:visibility="gone"
        android:nextFocusLeft="@+id/ly_change"
        android:nextFocusRight="@+id/ly_exit"
        android:nextFocusUp="@+id/ly_reload"
        android:nextFocusDown="@+id/ly_exit"
        android:clickable="true"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        app:layout_constraintEnd_toStartOf="@+id/ly_reload"
        app:layout_constraintTop_toBottomOf="@+id/ly_setting"
        app:layout_constraintTop_toTopOf="@+id/ly_setting">
        <ImageView
            android:id="@+id/image_change"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:src="@drawable/exit_icon"
            android:layout_marginStart="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/_11sdp"
            android:textColor="@color/white"
            android:id="@+id/txt_change"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/image_exit"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:gravity="center"
        android:id="@+id/webview"
        android:layout_width="@dimen/_280sdp"
        android:layout_height="@dimen/_20sdp"
        app:layout_constraintEnd_toStartOf="@+id/ly_reload"
        app:layout_constraintStart_toEndOf="@+id/image_logo_rtx"
        app:layout_constraintTop_toBottomOf="@+id/ly_setting"/>
    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:src="@drawable/loader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/txt_middle_font"
        android:textStyle="bold"
        android:textColor="@color/gray"
        android:id="@+id/txt_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:text="03:00AM"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/_13sdp"
        android:textColor="@color/white"
        android:id="@+id/txt_version"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_15sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
