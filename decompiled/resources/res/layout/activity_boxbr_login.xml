<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="false">
    <p029zz.XplayViewBG
        android:id="@+id/viewGroupdddd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <ImageView
        android:id="@+id/image_bg"
        android:background="@color/black_50"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="100">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_20sdp">
                <p029zz.XplayView
                    android:layout_gravity="top|center_horizontal"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_100sdp"
                    android:src="@drawable/home_logo"
                    android:scaleType="fitXY"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="@dimen/_220sdp"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DADOS DE ACESSO"/>
                <com.boxbrapks.UsernameEditText
                    android:textColor="@color/lb_grey"
                    android:textColorHint="@color/lb_grey"
                    android:gravity="center"
                    android:id="@+id/str_username"
                    android:tag="1"
                    android:background="@drawable/xplay_login_btn_selected"
                    android:padding="@dimen/_8sdp"
                    android:focusable="true"
                    android:nextFocusDown="@+id/str_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:hint="USUÁRIO"
                    android:singleLine="true"
                    android:imeOptions="actionNext">
                    <requestFocus/>
                </com.boxbrapks.UsernameEditText>
                <com.boxbrapks.PasswordEditText
                    android:textColor="@color/lb_grey"
                    android:textColorHint="@color/lb_grey"
                    android:gravity="center"
                    android:id="@+id/str_password"
                    android:tag="2"
                    android:background="@drawable/xplay_login_btn_selected"
                    android:padding="@dimen/_8sdp"
                    android:focusable="true"
                    android:nextFocusUp="@+id/str_username"
                    android:nextFocusDown="@+id/str_connections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:hint="SENHA"
                    android:singleLine="true"
                    android:imeOptions="actionDone"/>
                <Button
                    android:textSize="20sp"
                    android:textColor="#ffffffff"
                    android:id="@+id/str_connections"
                    android:tag="3"
                    android:background="@drawable/xplay_login_btn_selector"
                    android:padding="@dimen/_8sdp"
                    android:focusable="true"
                    android:nextFocusUp="@+id/str_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="CONECTAR"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:background="#af000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/lb_grey"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="MAC: "
                android:scaleX="0.9"
                android:scaleY="0.9"
                android:textAlignment="center"/>
            <TextView
                android:textColor="@color/lb_grey"
                android:layout_gravity="center"
                android:tag="10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:text="..."
                android:layout_weight="1"
                android:scaleX="0.9"
                android:scaleY="0.9"
                android:textAlignment="center"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:tag="4"
        android:background="#d7615701"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_60sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_25sdp"
                android:layout_margin="@dimen/_5sdp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#ffdfdfdf"
                android:layout_gravity="center"
                android:tag="5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_35sdp"
                android:text="Please wait..."
                android:layout_weight="1"
                android:textAlignment="center"/>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
