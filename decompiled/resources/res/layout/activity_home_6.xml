<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <p029zz.XplayViewBG
        android:id="@+id/viewGroupdddd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <ImageView
        android:id="@+id/image_bg"
        android:background="@color/black_50"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/west"
        android:background="@drawable/sub_bg"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_30sdp">
        <p029zz.XplayView
            android:id="@+id/image_logo"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/home_logo"
            android:layout_marginStart="@dimen/_7sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:layout_marginStart="@dimen/_7sdp"
            android:layout_marginEnd="@dimen/_30sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/image_logo"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextClock
            android:textSize="@dimen/_10sdp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:format12Hour="dd/MMMM/yyyy"
            android:format24Hour="dd/MMMM/yyyy"/>
        <TextClock
            android:textSize="@dimen/_17sdp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:format12Hour="hh:mm a"
            android:format24Hour="HH:mm"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ly_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginStart="@dimen/_15sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/west">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_live"
            android:background="@drawable/home_item_bg2"
            android:focusable="true"
            android:nextFocusLeft="@+id/ly_live"
            android:nextFocusRight="@+id/ly_movie"
            android:nextFocusUp="@+id/ly_live"
            android:nextFocusDown="@+id/ly_live"
            android:layout_width="@dimen/_55sdp"
            android:layout_height="@dimen/_30sdp"
            app:layout_constraintEnd_toStartOf="@+id/ly_movie"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/_13sdp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:id="@+id/txt_live"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CANAIS"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/_13sdp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:id="@+id/txt_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Canais"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <requestFocus/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_movie"
            android:background="@drawable/home_item_bg2"
            android:focusable="true"
            android:nextFocusLeft="@+id/ly_live"
            android:nextFocusRight="@+id/ly_series"
            android:nextFocusUp="@+id/ly_movie"
            android:nextFocusDown="@+id/ly_movie"
            android:layout_width="@dimen/_55sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginStart="@dimen/_5sdp"
            app:layout_constraintEnd_toStartOf="@+id/ly_series"
            app:layout_constraintStart_toEndOf="@+id/ly_live"
            app:layout_constraintTop_toTopOf="@+id/ly_live">
            <TextView
                android:textSize="@dimen/_13sdp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:id="@+id/txt_movie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FILMES"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_series"
            android:background="@drawable/home_item_bg2"
            android:focusable="true"
            android:nextFocusLeft="@+id/ly_movie"
            android:nextFocusRight="@+id/ly_account"
            android:nextFocusUp="@+id/ly_series"
            android:nextFocusDown="@+id/ly_series"
            android:layout_width="@dimen/_55sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginStart="@dimen/_5sdp"
            app:layout_constraintEnd_toStartOf="@+id/ly_account"
            app:layout_constraintStart_toEndOf="@+id/ly_movie"
            app:layout_constraintTop_toTopOf="@+id/ly_live">
            <TextView
                android:textSize="@dimen/_13sdp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:id="@+id/txt_series"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SÉRIES"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_account"
            android:background="@drawable/home_item_bg2"
            android:focusable="true"
            android:visibility="visible"
            android:nextFocusLeft="@+id/ly_series"
            android:nextFocusRight="@+id/ly_reload"
            android:nextFocusUp="@+id/ly_account"
            android:nextFocusDown="@+id/ly_account"
            android:layout_width="@dimen/_55sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginStart="@dimen/_5sdp"
            app:layout_constraintEnd_toStartOf="@+id/ly_change"
            app:layout_constraintStart_toEndOf="@+id/ly_series"
            app:layout_constraintTop_toTopOf="@+id/ly_live">
            <TextView
                android:textSize="@dimen/_13sdp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@+id/txt_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESPORTE"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_change"
            android:background="@drawable/home_item_bg2"
            android:focusable="true"
            android:visibility="gone"
            android:nextFocusLeft="@+id/ly_account"
            android:nextFocusRight="@+id/ly_reload"
            android:nextFocusUp="@+id/ly_change"
            android:nextFocusDown="@+id/ly_change"
            android:layout_width="@dimen/_55sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginStart="@dimen/_5sdp"
            app:layout_constraintEnd_toStartOf="@+id/ly_reload"
            app:layout_constraintStart_toEndOf="@+id/ly_account"
            app:layout_constraintTop_toTopOf="@+id/ly_live">
            <TextView
                android:textSize="@dimen/_13sdp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/txt_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLAYLIST"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_reload"
            android:background="@drawable/home_item_bg2"
            android:focusable="true"
            android:visibility="visible"
            android:nextFocusLeft="@+id/ly_account"
            android:nextFocusRight="@+id/ly_setting"
            android:nextFocusUp="@+id/ly_reload"
            android:nextFocusDown="@+id/ly_reload"
            android:layout_width="@dimen/_55sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginStart="@dimen/_5sdp"
            app:layout_constraintEnd_toStartOf="@+id/ly_setting"
            app:layout_constraintStart_toEndOf="@+id/ly_change"
            app:layout_constraintTop_toTopOf="@+id/ly_live">
            <TextView
                android:textSize="@dimen/_13sdp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/txt_reload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ATUALIZAR"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_setting"
            android:background="@drawable/home_item_bg2"
            android:focusable="true"
            android:visibility="visible"
            android:nextFocusLeft="@+id/ly_reload"
            android:nextFocusRight="@+id/ly_exit"
            android:nextFocusUp="@+id/ly_setting"
            android:nextFocusDown="@+id/ly_setting"
            android:layout_width="@dimen/_55sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginStart="@dimen/_5sdp"
            app:layout_constraintEnd_toStartOf="@+id/ly_exit"
            app:layout_constraintStart_toEndOf="@+id/ly_reload"
            app:layout_constraintTop_toTopOf="@+id/ly_live">
            <TextView
                android:textSize="@dimen/_13sdp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/txt_setting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AJUSTES"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ly_exit"
            android:background="@drawable/home_item_bg2"
            android:focusable="true"
            android:nextFocusLeft="@+id/ly_setting"
            android:nextFocusRight="@+id/ly_exit"
            android:nextFocusUp="@+id/ly_exit"
            android:nextFocusDown="@+id/ly_exit"
            android:layout_width="@dimen/_55sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginStart="@dimen/_5sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ly_setting"
            app:layout_constraintTop_toTopOf="@+id/ly_live">
            <TextView
                android:textSize="@dimen/_13sdp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/txt_exit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAIR APP"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <p029zz.XplayComboView
        android:id="@+id/exo_ad_overlay"
        android:background="@color/trans_parent"
        android:focusable="false"
        android:visibility="visible"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        app:cardCornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ly_home"/>
    <TextView
        android:textSize="@dimen/txt_middle_font"
        android:textStyle="bold"
        android:textColor="#ffffffff"
        android:id="@+id/txt_time"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="Expira"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:src="@drawable/loader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/_9sdp"
        android:textColor="#ffffffff"
        android:id="@+id/txt_version"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
