<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <stroke
                android:width="@dimen/_2sdp"
                android:color="@color/yellow"/>
            <padding
                android:left="@dimen/_2sdp"
                android:top="@dimen/_2sdp"
                android:right="@dimen/_2sdp"
                android:bottom="@dimen/_2sdp"/>
            <corners android:radius="@dimen/_10sdp"/>
            <gradient
                android:startColor="#bf0b0b0b"
                android:endColor="#bf0b0b0b"
                android:angle="0"
                android:type="radial"
                android:centerX="50%"
                android:centerY="50%"
                android:gradientRadius="56%"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <stroke
                android:width="@dimen/_2sdp"
                android:color="@color/yellow"/>
            <padding
                android:left="@dimen/_2sdp"
                android:top="@dimen/_2sdp"
                android:right="@dimen/_2sdp"
                android:bottom="@dimen/_2sdp"/>
            <corners android:radius="@dimen/_10sdp"/>
            <gradient
                android:startColor="#bf0b0b0b"
                android:endColor="#bf0b0b0b"
                android:angle="0"
                android:type="radial"
                android:centerX="50%"
                android:centerY="50%"
                android:gradientRadius="56%"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <stroke
                android:width="@dimen/_2sdp"
                android:color="@color/yellow"/>
            <padding
                android:left="@dimen/_2sdp"
                android:top="@dimen/_2sdp"
                android:right="@dimen/_2sdp"
                android:bottom="@dimen/_2sdp"/>
            <corners android:radius="@dimen/_10sdp"/>
            <gradient
                android:startColor="#bf0b0b0b"
                android:endColor="#bf0b0b0b"
                android:angle="0"
                android:type="radial"
                android:centerX="50%"
                android:centerY="50%"
                android:gradientRadius="56%"/>
        </shape>
    </item>
    <item>
        <shape>
            <stroke
                android:width="@dimen/_2sdp"
                android:color="#d20b0b0b"/>
            <padding
                android:left="@dimen/_2sdp"
                android:top="@dimen/_2sdp"
                android:right="@dimen/_2sdp"
                android:bottom="@dimen/_2sdp"/>
            <corners android:radius="@dimen/_10sdp"/>
            <gradient
                android:startColor="#bf0b0b0b"
                android:endColor="#bf0b0b0b"
                android:angle="90"
                android:type="linear"/>
        </shape>
    </item>
</selector>
